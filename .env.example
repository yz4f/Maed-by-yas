# Set NEXTAUTH_SECRET to a unique random value (for example: openssl rand -base64 32).
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-unique-random-secret"

# Optional local JSON fallback for isolated development only; the bundled fallback file contains sample data.
ALLOW_LOCAL_DB_FALLBACK="false"

# Discord OAuth application credentials. Register NEXTAUTH_URL + /api/auth/callback/discord as an OAuth redirect URI.
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Optional bot integration used for Discord role sync and reset request notifications.
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""
DISCORD_WEBHOOK_URL=""

